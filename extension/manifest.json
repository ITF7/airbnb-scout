{
  "manifest_version": 3,
  "name": "Scout for Airbnb",
  "short_name": "Scout",
  "version": "1.0.0",
  "description": "Describe your stay in plain words. Scout searches Airbnb in your browser, checks the best listings and ranks them. Not affiliated with Airbnb.",
  "homepage_url": "https://github.com/ITF7/airbnb-scout",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open Scout",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://www.airbnb.com/*",
    "https://data.police.uk/*",
    "https://api.tfl.gov.uk/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
